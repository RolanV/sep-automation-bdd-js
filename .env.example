# Copy this file to .env and fill in DEDICATED TEST-ACCOUNT credentials only.
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored - never commit real values.
#
# Values already present in the environment (for example from the VS Code
# integrated terminal) take precedence; .env is only a fallback.
#
# SEP_QA_URL must be an absolute http(s) URL with no embedded credentials.

SEP_QA_URL=https://replace-with-authorized-qa-host.example.com/
SEP_USERNAME=replace-with-test-account-username
SEP_PASSWORD=replace-with-test-account-password

# Payment scenarios (@sep23) require additional card variables. They are
# deliberately NOT listed here, so copying this template cannot enable a
# transaction by accident.
